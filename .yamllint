extends: default

ignore: |
  .git/
  local/generated/
  sample-app/
  .venv/

rules:
  line-length:
    max: 180
    level: warning
    # alert annotations are long human-readable Russian sentences
    ignore: |
      stacks/monitoring/prometheus/
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
