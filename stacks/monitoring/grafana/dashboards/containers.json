          },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"$container\",name!=\"\"}[2m]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
