{
  "uid": "autoops-postgres",
  "title": "AutoOps · PostgreSQL и Redis",
  "tags": [
    "autoops",
    "postgres"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Приложение",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(pg_up, app)",
          "refId": "var"
        },
        "definition": "label_values(pg_up, app)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Алерты",
        "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}"
      }
    ]
  },
  "links": [
    {
      "title": "AutoOps",
      "type": "dashboards",
      "tags": [
        "autoops"
      ],
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "id": 2,
      "type": "stat",
      "title": "PostgreSQL",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(pg_up{app=~\"$app\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      }
    },
