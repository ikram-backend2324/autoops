# AutoOps laptop demo settings. `make local-up` copies this file to local/.env once.
# These are throw-away DEMO values - never reuse them on a real server
# (servers get their secrets from ansible-vault, see docs/DATA.md).

SERVER_NAME=local-demo

# ---- application (stacks/app) ----
APP_NAME=sample
APP_IMAGE=autoops/sample-app
APP_TAG=local
APP_DOMAIN=localhost
# the sample app is published on http://localhost:${LOCAL_WEB_PORT}
LOCAL_WEB_PORT=8088
# container env file for web/worker/migrate (path relative to stacks/app/)
APP_ENV_FILE=../../local/.env
DJANGO_SECRET_KEY=local-demo-secret-key-change-me
DJANGO_DEBUG=0
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=local-demo-postgres
GUNICORN_WORKERS=2
CELERY_CONCURRENCY=2
# Django admin (http://localhost:8088/admin/) - created on first start if missing
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=autoops-admin
# chaos endpoints are needed for `make chaos`; keep them OFF on client servers
CHAOS_ENABLED=1
CHAOS_TOKEN=local-chaos-token

# ---- monitoring (stacks/monitoring) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=autoops
GRAFANA_URL=http://localhost:3000
# Leave empty: alerts are printed by notify-relay (docker compose logs -f notify-relay).
# Fill both to receive the demo alerts in Telegram (see docs/DATA.md#telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# demo rules (alert durations shortened to <= 1m by scripts/dev/fast_rules.py)
AUTOOPS_RULES_DIR=../../local/generated/rules
AUTOOPS_TARGETS_DIR=../../local/targets
AUTOOPS_TEXTFILE_DIR=textfile

# ---- backups: local S3 (versitygw) instead of Backblaze B2 / Cloudflare R2 ----
S3_ACCESS_KEY=autoops
S3_SECRET_KEY=autoops-local-secret
RESTIC_REPOSITORY=s3:http://s3:7070/autoops-backups
RESTIC_PASSWORD=local-demo-restic-password
