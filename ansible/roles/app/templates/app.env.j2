# {{ ansible_managed }}
# Settings + secrets of app "{{ app.name }}". The running image tag is in tag.env.
APP_NAME={{ app.name }}
APP_IMAGE={{ app.image }}
APP_DOMAIN={{ app.domain }}
APP_ENV_FILE=.env
TRAEFIK_ENABLE=true
SERVER_NAME={{ autoops_server_name }}

DJANGO_SECRET_KEY={{ app_secrets[app.name].django_secret_key }}
DJANGO_DEBUG=0
DJANGO_SECURE_COOKIES=1
POSTGRES_DB={{ app.postgres_db }}
POSTGRES_USER={{ app.postgres_user }}
POSTGRES_PASSWORD={{ app_secrets[app.name].postgres_password }}

GUNICORN_WORKERS={{ app.gunicorn_workers }}
CELERY_CONCURRENCY={{ app.celery_concurrency }}
WEB_CPUS={{ app.web_cpus }}
WEB_MEMORY={{ app.web_memory }}
WORKER_CPUS={{ app.worker_cpus }}
WORKER_MEMORY={{ app.worker_memory }}
POSTGRES_CPUS={{ app.postgres_cpus }}
POSTGRES_MEMORY={{ app.postgres_memory }}
CHAOS_ENABLED={{ '1' if app.chaos_enabled | default(false) else '0' }}
{% if app.chaos_enabled | default(false) %}
CHAOS_TOKEN={{ app_secrets[app.name].chaos_token | default(app_secrets[app.name].django_secret_key | hash('sha1')) }}
{% endif %}

# app-specific environment
{% for key, value in app.env.items() %}
{{ key }}={{ value }}
{% endfor %}
