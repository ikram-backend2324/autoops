# {{ ansible_managed }}
SERVER_NAME={{ autoops_server_name }}
RESTIC_REPOSITORY={{ restic_repository }}
RESTIC_PASSWORD={{ restic_password }}
AWS_ACCESS_KEY_ID={{ s3_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ s3_secret_access_key }}
RESTIC_CACHE_DIR=/var/cache/restic
BACKUP_APPS={{ backup_apps | join(' ') }}
BACKUP_STAGING=/var/backups/autoops
{% for a in autoops_apps %}
VERIFY_TABLES_{{ a.name | upper | replace('-', '_') }}={{ a.verify_tables | default([]) | join(' ') }}
{% endfor %}
KEEP_DAILY={{ backup_keep_daily }}
KEEP_WEEKLY={{ backup_keep_weekly }}
KEEP_MONTHLY={{ backup_keep_monthly }}
TEXTFILE_DIR=/var/lib/node_exporter/textfile
NOTIFY_URL=http://127.0.0.1:9095/notify
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
TELEGRAM_CHAT_ID={{ telegram_chat_id }}
