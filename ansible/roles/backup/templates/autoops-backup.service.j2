# {{ ansible_managed }}
[Unit]
Description=AutoOps backup (pg_dump + media -> restic -> S3)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/autoops/backup.env
ExecStart={{ autoops_root }}/scripts/backup/backup.sh
TimeoutStartSec=6h
Nice=10
IOSchedulingClass=idle
